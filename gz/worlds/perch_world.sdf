<?xml version="1.0" encoding="UTF-8"?>
<!-- Xe chở tấm bám 65°, điều khiển qua /model/perch_cart/cmd_vel. -->
<sdf version="1.9">
  <world name="perch_world">
    <physics type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <sensor name="eval_ground_contact" type="contact">
          <contact><collision>collision</collision></contact>
        </sensor>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.6 0.65 0.6 1</ambient><diffuse>0.6 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
    </light>

    <!-- cart + tilted perch plate -->
    <model name="perch_cart">
      <pose>8 0 0.45 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>200</mass>
          <inertia><ixx>30</ixx><iyy>60</iyy><izz>70</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="box_col">
          <geometry><box><size>2.0 2.0 0.8</size></box></geometry>
        </collision>
        <sensor name="eval_cart_contact" type="contact">
          <contact><collision>box_col</collision></contact>
        </sensor>
        <visual name="box_vis">
          <geometry><box><size>2.0 2.0 0.8</size></box></geometry>
          <material><ambient>0.2 0.3 0.7 1</ambient><diffuse>0.2 0.3 0.7 1</diffuse></material>
        </visual>
        <visual name="post_vis">
          <pose>-0.75 0 0.55 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.3</length></cylinder></geometry>
        </visual>
      </link>
      <!-- Pháp tuyến hướng về sau và lên trên. -->
      <link name="plate">
        <pose>-0.8 0 0.85 0 -1.134464014 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.003382</ixx><iyy>0.003382</iyy><izz>0.00675</izz></inertia>
        </inertial>
        <collision name="plate_surface">
          <geometry><box><size>0.45 0.45 0.02</size></box></geometry>
        </collision>
        <sensor name="eval_plate_contact" type="contact">
          <contact><collision>plate_surface</collision></contact>
        </sensor>
        <visual name="plate_vis">
          <geometry><box><size>0.45 0.45 0.02</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="plate_mount" type="fixed">
        <parent>body</parent>
        <child>plate</child>
      </joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <initial_linear>0 0 0</initial_linear>
      </plugin>
      <plugin filename="libHoldPad.so" name="perchpilot::HoldPad">
        <drone_model>x500_7</drone_model>
        <drone_link>base_link</drone_link>
        <mu>0.9</mu>
        <f_hold_n>60.75</f_hold_n>
        <pad_offset>0.227</pad_offset>
      </plugin>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
